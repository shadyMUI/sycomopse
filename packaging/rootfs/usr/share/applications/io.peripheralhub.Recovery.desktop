[Desktop Entry]
Type=Application
Name=Restore mouse mappings
Name[it]=Ripristina mouse
Comment=Disable only Sycomopse mouse mappings
Exec=/usr/bin/peripheral-hub-remapping-agent --disable-all
TryExec=/usr/bin/peripheral-hub-remapping-agent
Icon=peripheral-hub
Terminal=true
Categories=Settings;HardwareSettings;
Keywords=mouse;remapping;recovery;
