#!/bin/sh
set -eu
if [ "$1" = remove ] || [ "$1" = purge ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi
    if [ "$1" = purge ] && command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper purge peripheral-hub-input-remapper.service || true
    fi
fi
exit 0
