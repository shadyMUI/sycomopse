post_install() {
    python3 -I -B /usr/lib/peripheral-hub/installer/native.py configure --format arch
}

post_upgrade() {
    python3 -I -B /usr/lib/peripheral-hub/installer/native.py configure --format arch --upgrade
}

pre_remove() {
    python3 -I -B /usr/lib/peripheral-hub/installer/native.py remove --format arch
}

post_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi
}
