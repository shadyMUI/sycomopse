post_install() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl stop peripheral-hub-input-remapper.service || true
    fi
}

post_remove() {
    post_install
}
